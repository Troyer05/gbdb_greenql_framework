{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "greenQL",
  "scopeName": "source.greenql",
  "fileTypes": [
    "gql",
    "greenql",
    "gq",
    "gbdb",
    "gdb"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#jsonKeys"
    },
    {
      "include": "#definitions"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#slashBridge"
    },
    {
      "include": "#optionalParams"
    },
    {
      "include": "#qualified"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#numbersOps"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.divider.greenql",
          "match": "^\\s*#\\s*[=\\-]{8,}.*$"
        },
        {
          "name": "comment.line.number-sign.greenql",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.greenql",
          "match": "//.*$"
        },
        {
          "name": "comment.line.double-dash.greenql",
          "match": "--.*$"
        },
        {
          "name": "comment.block.greenql",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.greenql",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.greenql",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.greenql",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.greenql",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.backtick.greenql",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.greenql",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "jsonKeys": {
      "patterns": [
        {
          "match": "(\"[^\"\\\\]*(?:\\\\.[^\"\\\\]*)*\")\\s*(:)",
          "captures": {
            "1": {
              "name": "entity.name.tag.json-key.greenql"
            },
            "2": {
              "name": "punctuation.separator.key-value.greenql"
            }
          }
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "(?i)\\b(PUB|PRIV|PUBLIC|PRIVATE|PROTECTED|STATIC)?\\s*\\b(F|FUNCTION)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "storage.modifier.visibility.greenql"
            },
            "2": {
              "name": "storage.type.function.greenql keyword.declaration.function.greenql"
            },
            "3": {
              "name": "entity.name.function.definition.greenql"
            }
          }
        },
        {
          "match": "(?i)\\b(C|CLASS)\\s+([A-Za-z_][A-Za-z0-9_]*)(?!\\s*[/\\(])",
          "captures": {
            "1": {
              "name": "storage.type.class.greenql keyword.declaration.class.greenql"
            },
            "2": {
              "name": "entity.name.type.class.greenql"
            }
          }
        },
        {
          "match": "(?i)\\b(PUB|PRIV|PUBLIC|PRIVATE|PROTECTED|STATIC)\\b",
          "name": "storage.modifier.visibility.greenql"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?i)\\b(PUB|PRIV|PUBLIC|PRIVATE|PROTECTED)?\\s*\\b(DECLARE|DECALRE|DELACE)\\s+(:)([A-Za-z_][A-Za-z0-9_]*)\\s+(\\$?[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.visibility.greenql"
            },
            "2": {
              "name": "storage.type.declaration.greenql keyword.declaration.variable.greenql"
            },
            "3": {
              "name": "punctuation.definition.type.greenql"
            },
            "4": {
              "name": "support.type.greenql"
            },
            "5": {
              "name": "variable.other.declaration.greenql"
            }
          }
        },
        {
          "match": "(?i)\\b(PUB|PRIV|PUBLIC|PRIVATE|PROTECTED)?\\s*\\b(DECLARE|DECALRE|DELACE)\\s+(\\$?[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.visibility.greenql"
            },
            "2": {
              "name": "storage.type.declaration.greenql keyword.declaration.variable.greenql"
            },
            "3": {
              "name": "variable.other.declaration.greenql"
            }
          }
        }
      ]
    },
    "slashBridge": {
      "patterns": [
        {
          "match": "(?i)\\b(srv|SRV|Srv|secondserver|Secondserver|SecondServer)\\s*(/)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.type.namespace.srvp.greenql"
            },
            "2": {
              "name": "punctuation.separator.srvp.greenql"
            },
            "3": {
              "name": "support.function.bridge.action.greenql"
            }
          }
        },
        {
          "match": "(?i)\\b(CALL|CLASS)\\s+([A-Za-z_][A-Za-z0-9_]*)(/)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "keyword.control.call.greenql"
            },
            "2": {
              "name": "entity.name.type.class.greenql"
            },
            "3": {
              "name": "punctuation.separator.method.greenql"
            },
            "4": {
              "name": "entity.name.function.call.user.greenql"
            }
          }
        }
      ]
    },
    "optionalParams": {
      "patterns": [
        {
          "match": "(\\?)\\s*(\\$?[A-Za-z_][A-Za-z0-9_]*)(\\s*:\\s*)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.optional.greenql"
            },
            "2": {
              "name": "variable.parameter.optional.greenql"
            },
            "3": {
              "name": "punctuation.definition.type.greenql"
            },
            "4": {
              "name": "support.type.greenql"
            }
          }
        },
        {
          "match": "(\\?)\\s*(\\$?[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.optional.greenql"
            },
            "2": {
              "name": "variable.parameter.optional.greenql"
            }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.identity.greenql support.function.builtin.greenql",
          "match": "(?i)\\b(?:uni_random|random_int|spark_id|fresh_id|fusion|param|uuid|now|len|ENV)\\s*(?=\\()"
        },
        {
          "name": "support.function.builtin.hash.greenql support.function.builtin.greenql",
          "match": "(?i)\\b(?:hash_adler32|hash_sha256|hash_sha512|hash_crc32|hash_pass|hash_md5|hash)\\s*(?=\\()"
        },
        {
          "name": "support.function.builtin.pattern.greenql support.function.builtin.greenql",
          "match": "(?i)\\b(?:exec_pattern|load_pattern|execPattern|loadpattern|execpattern|loadPattern)\\s*(?=\\()"
        },
        {
          "name": "support.function.builtin.api.greenql support.function.builtin.greenql",
          "match": "(?i)\\b(?:api_fetch|fetch_api|call_api)\\s*(?=\\()"
        },
        {
          "name": "support.function.builtin.data.greenql support.function.builtin.greenql",
          "match": "(?i)\\b(?:delete_data_recursive|transfer_data_delete|set_data_readonly|instance_exists|transfer_data|get_instances|reshape_data|table_exists|base_exists|delete_data|data_exists|erase_data|last_added|count_data|tally_data|fetch_data|plant_data|get_tables|copy_data|last_data|seed_data|lock_data|move_data|get_bases|instances|edit_data|get_data|editdata|add_data|tables|bases|fetch)\\s*(?=\\()"
        },
        {
          "name": "support.function.builtin.schema.greenql support.function.builtin.greenql",
          "match": "(?i)\\b(?:delete_instance|rename_instance|delete_column|drop_instance|sprout_column|rename_table|delete_table|prune_column|rename_base|delete_base|new_column|drop_table|drop_base)\\s*(?=\\()"
        },
        {
          "name": "support.function.builtin.advanced.greenql support.function.builtin.greenql",
          "match": "(?i)\\b(?:install_social_patterns|social_schema_patterns|retry_failed_jobs|encryption_config|user_data_redact|user_data_delete|user_data_export|define_procedure|evaluate_policy|fulltext_search|define_db_user|define_db_role|call_procedure|define_trigger|mark_pii_field|define_policy|refresh_view|audit_export|delete_media|audit_search|define_view|delayed_job|enqueue_job|queue_stats|soft_delete|rotate_key|signed_url|get_view|put_blob|recover|monitor|cursor|page)\\s*(?=\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.greenql",
          "match": "(?i)\\b(?:PROTECTED|FUNCTION|PRIVATE|DECLARE|DECALRE|PUBLIC|DELACE|STATIC|CLASS|PRIV|META|PUB|C|F)\\b"
        },
        {
          "name": "keyword.control.greenql",
          "match": "(?i)\\b(?:DELETE_LOG_FILE|SET_LOGFILE|MAP_OBJECT|CLEAR_LOG|END_PROC|OUTPUT|ERROR|CLASS|CALL|BACK|ELSE|FOR|LOG|MSG|IF)\\b"
        },
        {
          "name": "keyword.danger.greenql",
          "match": "(?i)\\b(?:ROLLBACK|UNINDEX|DELETE|REVOKE|ERASE|DROP)\\b"
        },
        {
          "name": "keyword.transaction.greenql",
          "match": "(?i)\\b(?:TRANSACTION|SAVEPOINT|TIMEOUT|COMMIT|BEGIN|TX|TO)\\b"
        },
        {
          "name": "keyword.structure.greenql",
          "match": "(?i)\\b(?:INSTANCES|DESCRIBE|INSTANCE|COLUMNS|DEFAULT|WITHOUT|COLUMN|TABLES|RENAME|BRANCH|BASES|TABLE|TYPES|ALTER|BASE|ROOT|EDIT|TYPE|WITH|SHOW|GROW|INTO|ADD|USE)\\b"
        },
        {
          "name": "keyword.query.greenql",
          "match": "(?i)\\b(?:DISTINCT|EXPLAIN|EXECUTE|OPTIONS|RESHAPE|PREPARE|EXISTS|OFFSET|HAVING|SEARCH|WHERE|COUNT|QUERY|LIMIT|GROUP|INNER|AFTER|SIZE|SORT|JOIN|FROM|DESC|DATA|LEFT|PICK|SEED|MIN|ASC|MAX|SUM|AVG|IN|BY|ON)\\b"
        },
        {
          "name": "keyword.engine.greenql",
          "match": "(?i)\\b(?:MIGRATE_TO_V2|SUGGESTIONS|CONSTRAINTS|REFERENCES|CONSTRAINT|COMPOSITE|RELATIONS|REQUIRED|FULLTEXT|SET_NULL|RESTRICT|SNAPSHOT|CASCADE|SUGGEST|INDEXES|MONITOR|FOREIGN|MIGRATE|RECOVER|ANALYZE|REINDEX|PREFIX|REPAIR|HEALTH|SORTED|CREATE|UNIQUE|CURSOR|BACKUP|CHECK|RANGE|INDEX|STATS|PEEK|PAGE|AUTO|PACK|KEY)\\b"
        },
        {
          "name": "keyword.cluster.greenql",
          "match": "(?i)\\b(?:PARTITIONS|PARTITION|HEARTBEAT|READ_ONLY|READONLY|WRITABLE|REGISTER|PRIMARY|REPLICA|BUCKETS|CLUSTER|SHARDS|WORKER|TENANT|SHARD|USER|DATE|NODE|ROLE|HASH)\\b"
        },
        {
          "name": "keyword.security.greenql",
          "match": "(?i)\\b(?:REVOKE|GRANT)\\b"
        },
        {
          "name": "keyword.file.greenql",
          "match": "(?i)\\b(?:INCLUDE|PATTERN|EXEC|FILE|RUN)\\b"
        },
        {
          "name": "constant.language.boolean.greenql",
          "match": "(?i)\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.greenql",
          "match": "(?i)\\bnull\\b"
        },
        {
          "name": "constant.language.time.greenql",
          "match": "(?i)\\bNOW\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.greenql",
          "match": "(?i)(:?)\\b(?:blob_reference|timestamp|datetime|datetype|timetype|decimal|boolean|integer|object|number|double|string|float|mixed|email|array|text|bool|date|uuid|time|json|ulid|blob|enum|any|map|arr|str|obj|int|url|var)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.this.greenql",
          "match": "(?i)\\bthis\\s*\\.\\s*_[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "variable.other.constant.greenql",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "variable.other.local.greenql",
          "match": "_[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.call.user.greenql",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\s*(?=\\()"
        }
      ]
    },
    "qualified": {
      "patterns": [
        {
          "match": "\\b([A-Za-z0-9_\\-]+)(\\.)([A-Za-z0-9_\\-]+)\\b",
          "captures": {
            "1": {
              "name": "entity.name.namespace.base.greenql"
            },
            "2": {
              "name": "punctuation.accessor.greenql"
            },
            "3": {
              "name": "entity.name.namespace.table.greenql"
            }
          }
        }
      ]
    },
    "numbersOps": {
      "patterns": [
        {
          "name": "constant.numeric.greenql",
          "match": "-?\\b\\d+(?:\\.\\d+)?(?:e[+-]?\\d+)?\\b"
        },
        {
          "name": "keyword.operator.comparison.greenql",
          "match": "==|!=|>=|<=|~=|>|<|="
        },
        {
          "name": "keyword.operator.logical.greenql",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.greenql",
          "match": "\\+\\+|--|[+\\-*/%]"
        },
        {
          "name": "punctuation.section.block.greenql",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.array.greenql",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.greenql",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.greenql",
          "match": "[;,.]"
        },
        {
          "name": "punctuation.separator.key-value.greenql",
          "match": ":"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.identifier.greenql",
          "match": "\\b[A-Za-z_][A-Za-z0-9_\\-]*\\b"
        }
      ]
    }
  }
}
