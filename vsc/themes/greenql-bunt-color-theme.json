        "fontStyle": "bold"
      }
    },
    {
      "scope": "support.function.data.greenql",
      "settings": {
        "foreground": "#c099ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "support.function.schema.greenql",
      "settings": {
        "foreground": "#56d4dd",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "keyword.operator.exists.greenql",
      "settings": {
