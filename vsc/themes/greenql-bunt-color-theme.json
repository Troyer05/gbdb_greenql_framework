{
  "$schema": "vscode://schemas/color-theme",
  "name": "greenQL Bunt",
  "type": "dark",
  "colors": {
    "editor.background": "#0b1020",
    "editor.foreground": "#e6edf3",
    "editorCursor.foreground": "#52ffa8",
    "editorLineNumber.foreground": "#536179",
    "editorLineNumber.activeForeground": "#8be9fd",
    "editor.selectionBackground": "#284b7a",
    "editor.inactiveSelectionBackground": "#1e344f",
    "editorIndentGuide.background1": "#1b2740",
    "editorIndentGuide.activeBackground1": "#52ffa8",
    "editor.lineHighlightBackground": "#101935",
    "editorBracketMatch.background": "#2f4f7f66",
    "editorBracketMatch.border": "#52ffa8",
    "activityBar.background": "#070b16",
    "sideBar.background": "#090f1f",
    "statusBar.background": "#0f5132",
    "statusBar.foreground": "#f0fff6"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#7f8ca3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string.quoted",
      "settings": {
        "foreground": "#9cdcfe"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#ffd166",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "scope": "constant.language.boolean.greenql",
      "settings": {
        "foreground": "#ff7bba",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "constant.language.null.greenql",
      "settings": {
        "foreground": "#c678dd",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "constant.language.time.greenql",
      "settings": {
        "foreground": "#f2cc60",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "storage.type.declaration.greenql",
      "settings": {
        "foreground": "#ffdf5d",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "variable.other.declaration.greenql",
