    {
      "scope": "invalid.illegal.variable.no-underscore.greenql",
      "settings": {
        "foreground": "#ffffff",
        "background": "#c62828",
        "fontStyle": "underline bold"
      }
    },
    {
      "scope": "constant.other.user.greenql",
      "settings": {
        "foreground": "#ffdf5d",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "support.function.output.greenql",
      "settings": {
