      "scope": "support.function.parameter.greenql",
      "settings": {
        "foreground": "#f2cc60",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "support.function.hash.greenql",
      "settings": {
        "foreground": "#c099ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "support.function.convert.greenql",
      "settings": {
