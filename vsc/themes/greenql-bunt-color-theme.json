    {
      "scope": "entity.name.database.greenql",
      "settings": {
        "foreground": "#79c0ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "keyword.other.meta.greenql",
      "settings": {
        "foreground": "#ffdf5d",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "meta.object.key.quoted.greenql",
        "meta.object.key.bare.greenql"
      ],
      "settings": {
        "foreground": "#f2cc60"
      }
    },
    {
      "scope": "invalid.illegal.variable.no-prefix.greenql",
      "settings": {
        "foreground": "#ff5f73",
        "fontStyle": "bold underline"
      }
    }
