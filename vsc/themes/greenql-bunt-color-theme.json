  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": "#58a6ff",
    "keyword.declaration": "#ffdf5d",
    "keyword.control": "#f778ba",
    "keyword.danger": "#ff5f73",
    "function": "#d2a8ff",
    "function.runtime": "#52ffa8",
    "method": "#ffa657",
    "class": "#ffdf5d",
    "type": "#56d4dd",
    "namespace": "#79c0ff",
    "variable": "#7ee787",
    "variable.readonly": "#ffdf5d",
    "parameter": "#52ffa8",
    "property": "#f2cc60",
    "string": "#9cdcfe",
    "number": "#79c0ff",
    "comment": "#7f8ca3",
    "operator": "#ffab70",
    "macro": "#ff7bba",
    "enumMember": "#c678dd"
  }
