{
  "$schema": "vscode://schemas/color-theme",
  "name": "greenQL Pro Ultra Semantic 2026",
  "type": "dark",
  "colors": {
    "editor.background": "#05070D",
    "editor.foreground": "#E8F1FF",
    "editorLineNumber.foreground": "#2F3B52",
    "editorLineNumber.activeForeground": "#B7C6FF",
    "editorCursor.foreground": "#00FFD1",
    "editor.selectionBackground": "#244B7A88",
    "editor.wordHighlightBackground": "#33415566",
    "editor.wordHighlightStrongBackground": "#7C3AED55",
    "editorBracketMatch.background": "#00FFD122",
    "editorBracketMatch.border": "#00FFD1",
    "editorIndentGuide.background1": "#172033",
    "editorIndentGuide.activeBackground1": "#3B82F6",
    "editorGutter.background": "#05070D",
    "editor.lineHighlightBackground": "#111827AA",
    "editorError.foreground": "#FF3355",
    "editorWarning.foreground": "#FFD166",
    "editorInfo.foreground": "#38BDF8",
    "sideBar.background": "#080B12",
    "activityBar.background": "#05070D",
    "statusBar.background": "#0F172A",
    "statusBar.foreground": "#CFFAFE",
    "tab.activeBackground": "#0B1220",
    "tab.inactiveBackground": "#070A12",
    "tab.activeForeground": "#FFFFFF",
    "panel.background": "#070A12",
    "terminal.background": "#05070D",
    "terminal.foreground": "#D8E6FF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment.line.divider.greenql"
      ],
      "settings": {
        "foreground": "#41516E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#64748B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#7CFF6B"
      }
    },
    {
      "scope": [
        "entity.name.tag.json-key.greenql"
      ],
      "settings": {
        "foreground": "#6EE7F9",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#38BDF8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.time"
      ],
      "settings": {
        "foreground": "#FBBF24",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.type.declaration",
        "keyword.declaration",
        "keyword.declaration.variable",
        "keyword.declaration.function",
        "keyword.declaration.class"
      ],
      "settings": {
        "foreground": "#FF4FD8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#FDE047",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.danger",
        "keyword.structure.greenql"
      ],
      "settings": {
        "foreground": "#FF4D6D",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.query"
      ],
      "settings": {
        "foreground": "#60A5FA",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.engine",
        "keyword.index",
        "keyword.constraint"
      ],
      "settings": {
        "foreground": "#C084FC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.cluster",
        "keyword.security",
        "keyword.transaction"
      ],
      "settings": {
        "foreground": "#FB7185",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#93C5FD",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "support.type",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#38BDF8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable.other.local"
      ],
      "settings": {
        "foreground": "#34D399",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FACC15",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable.parameter.optional"
      ],
      "settings": {
        "foreground": "#A7F3D0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "support.function.builtin.identity"
      ],
      "settings": {
        "foreground": "#22D3EE",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "support.function.builtin.hash"
      ],
      "settings": {
        "foreground": "#FB7185",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "support.function.builtin.pattern"
      ],
      "settings": {
        "foreground": "#E879F9",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "support.function.builtin.api"
      ],
      "settings": {
        "foreground": "#F97316",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "support.function.builtin.data"
      ],
      "settings": {
        "foreground": "#22C55E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "support.function.builtin.schema"
      ],
      "settings": {
        "foreground": "#FDE047",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "support.function.builtin.advanced"
      ],
      "settings": {
        "foreground": "#A78BFA",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "support.function.bridge",
        "support.function.bridge.action"
      ],
      "settings": {
        "foreground": "#14F195",
        "fontStyle": "bold underline"
      }
    },
    {
      "scope": [
        "entity.name.function.definition"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold underline"
      }
    },
    {
      "scope": [
        "entity.name.function.call.user"
      ],
      "settings": {
        "foreground": "#FDBA74",
        "fontStyle": "bold italic"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#5EEAD4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator.srvp",
        "punctuation.separator.method"
      ],
      "settings": {
        "foreground": "#FF4FD8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#94A3B8"
      }
    },
    {
      "scope": [
        "entity.name.identifier"
      ],
      "settings": {
        "foreground": "#CBD5E1"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword.declaration:greenql": {
      "foreground": "#FF4FD8",
      "fontStyle": "bold"
    },
    "keyword.control:greenql": {
      "foreground": "#FDE047",
      "fontStyle": "bold"
    },
    "keyword.danger:greenql": {
      "foreground": "#FF1744",
      "fontStyle": "bold underline"
    },
    "keyword:greenql": {
      "foreground": "#7DD3FC",
      "fontStyle": "bold"
    },
    "variable.readonly:greenql": {
      "foreground": "#FACC15",
      "fontStyle": "bold"
    },
    "variable:greenql": {
      "foreground": "#34D399",
      "fontStyle": "bold"
    },
    "parameter:greenql": {
      "foreground": "#A7F3D0",
      "fontStyle": "italic"
    },
    "function.declaration:greenql": {
      "foreground": "#FFFFFF",
      "fontStyle": "bold underline"
    },
    "function.runtime.identity:greenql": {
      "foreground": "#22D3EE",
      "fontStyle": "bold"
    },
    "function.runtime.hash:greenql": {
      "foreground": "#FB7185",
      "fontStyle": "bold"
    },
    "function.runtime.pattern:greenql": {
      "foreground": "#E879F9",
      "fontStyle": "bold"
    },
    "function.runtime.data:greenql": {
      "foreground": "#22C55E",
      "fontStyle": "bold"
    },
    "function.runtime.schema:greenql": {
      "foreground": "#FDE047",
      "fontStyle": "bold"
    },
    "function.runtime.advanced:greenql": {
      "foreground": "#A78BFA",
      "fontStyle": "bold"
    },
    "function.user:greenql": {
      "foreground": "#FDBA74",
      "fontStyle": "bold italic"
    },
    "method.runtime.advanced:greenql": {
      "foreground": "#14F195",
      "fontStyle": "bold underline"
    },
    "method:greenql": {
      "foreground": "#FB7185",
      "fontStyle": "bold"
    },
    "property:greenql": {
      "foreground": "#CBD5E1"
    },
    "class:greenql": {
      "foreground": "#C084FC",
      "fontStyle": "bold underline"
    },
    "type:greenql": {
      "foreground": "#38BDF8",
      "fontStyle": "bold italic"
    },
    "namespace:greenql": {
      "foreground": "#5EEAD4",
      "fontStyle": "bold"
    },
    "operator:greenql": {
      "foreground": "#FF4FD8",
      "fontStyle": "bold"
    },
    "macro:greenql": {
      "foreground": "#FBBF24",
      "fontStyle": "bold"
    },
    "string:greenql": {
      "foreground": "#7CFF6B"
    },
    "number:greenql": {
      "foreground": "#38BDF8",
      "fontStyle": "bold"
    },
    "comment:greenql": {
      "foreground": "#64748B",
      "fontStyle": "italic"
    }
  }
}
