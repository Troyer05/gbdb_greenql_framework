    ],
    "description": "Logdatei setzen"
  },
  "Log": {
    "prefix": [
      "log"
    ],
    "body": [
      "LOG(${1:_value});"
    ],
    "description": "Log schreiben"
  },
  "If else": {
    "prefix": [
      "if",
      "ifelse"
    ],
    "body": [
      "IF (${1:_value} == ${2:true}) {",
      "    ${3:OUTPUT(\"ok\");}",
      "} ELSE {",
      "    ${4:ERROR MSG \"not ok\";}",
      "}"
    ],
    "description": "IF / ELSE Block"
