      "}"
    ],
    "description": "FOR über Array"
  },
  "For counter": {
    "prefix": [
      "fori",
      "counter loop"
    ],
    "body": [
      "FOR (_${1:i} = 0; _${1:i} < ${2:10}; _${1:i}++) {",
      "    ${3:OUTPUT(_${1:i});}",
      "}"
    ],
    "description": "FOR Zählschleife"
  },
  "Map object": {
    "prefix": [
      "map",
      "map_object"
    ],
    "body": [
      "MAP_OBJECT(_${1:object} AS _${2:key}, _${3:value}) {",
      "    ${4:LOG(_${2:key}, _${3:value});}",
      "}"
    ],
    "description": "Objekt/Array iterieren"
  },
  "Function": {
    "prefix": [
      "f",
      "function"
    ],
    "body": [
      "F ${1:myFunction}(_${2:value}) {",
