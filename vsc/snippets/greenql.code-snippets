  "Pattern bootstrap MuseumQR": {
    "prefix": [
      "pattern museumqr",
      "museumqr bootstrap",
      "exec pattern museumqr"
    ],
    "body": [
      "declare \\$mid = param(\"museum_id\");",
      "declare \\$instance = param(\"main_instance\");",
      "declare \\$name = param(\"museum_name\");",
      "declare \\$logo = param(\"logo_path\");",
      "declare \\$intro = param(\"intro\");",
      "declare \\$kdnr = param(\"kunden_nr\");",
      "declare \\$lKey = param(\"license_key\");",
      "",
      "declare \\$expoInstance = \"expokey\";",
      "declare \\$pattern = loadPattern(\"museumqr\");",
      "declare \\$expoPattern = loadPattern(\"expokey\");",
      "",
      "if (!instance_exists(\\$instance)) {",
      "    GROW INSTANCE \\$instance;",
      "}",
      "",
      "USE INSTANCE \\$instance;",
      "EXEC PATTERN \\$pattern;",
      "",
      "ROOT system;",
      "",
      "SEED users WITH",
      "    uid=uni_random(),",
      "    username=\"admin\",",
      "    email=\"\",",
      "    name=\"Administrator\",",
      "    password=hash_sha256(\"admin\"),",
      "    role=\"admin\",",
      "    active=true,",
      "    admin_theme=\"dark\",",
      "    created_at=now(),",
      "    updated_at=now(),",
      "    last_login=\"\";",
      "",
      "if (!instance_exists(\\$expoInstance)) {",
      "    GROW INSTANCE \\$expoInstance;",
      "}",
      "",
      "USE INSTANCE \\$expoInstance;",
      "EXEC PATTERN \\$expoPattern;"
    ],
    "description": "MuseumQR + ExpoKey Pattern-Initialisierung"
  },
