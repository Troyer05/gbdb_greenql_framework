{
  "Meta block": {
    "prefix": [
      "meta",
      "script meta"
    ],
    "body": [
      "META = {",
      "    \"GreenQL_version\": 2,",
      "    \"description\": \"${1:Description}\",",
      "    \"params\": [",
      "        {\"parameter\": \"${2:name}\", \"required\": false}",
      "    ]",
      "};"
    ],
    "description": "Script-Metadaten setzen"
  },
  "Declare variable": {
    "prefix": [
      "declare",
      "var"
    ],
    "body": [
      "DECLARE _${1:name} = ${2:value};"
    ],
    "description": "Variable deklarieren"
  },
  "Declare constant": {
    "prefix": [
      "const",
      "declare const",
      "$"
    ],
    "body": [
      "DECLARE \\$${1:NAME} = ${2:value};"
    ],
    "description": "Konstante deklarieren"
  },
  "Declare param": {
    "prefix": [
      "param",
      "declare param"
    ],
    "body": [
      "DECLARE _${1:name} = param(\"${2:name}\");"
    ],
    "description": "Runtime-Parameter lesen"
  },
  "ENV read": {
    "prefix": [
      "env",
      "ENV"
    ],
    "body": [
      "DECLARE _${1:key} = ENV(\"${1:key}\");"
    ],
    "description": "ENV aus .config/.greenql.env.php lesen"
  },
  "Output": {
    "prefix": [
      "output",
      "out"
    ],
    "body": [
      "OUTPUT(${1:_value});"
    ],
    "description": "Output schreiben"
  },
  "Set logfile": {
    "prefix": [
      "setlog",
      "set logfile"
    ],
    "body": [
